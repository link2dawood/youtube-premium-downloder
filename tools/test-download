#!/usr/bin/env bash
#
# End-to-end test of the installed PixelCatch helper. Sends a real native-
# messaging frame to /Library/Application Support/PixelCatch/downloader.py,
# streams the progress / done / error events, and reports the resulting file.
#
# Because this invokes the actual helper, the runtime format-fallback chain
# (members-only → broader selector → 'best') is exercised exactly as the
# popup would trigger it. No duplicated format-string logic.
#
# Usage:
#   bash tools/test-download                                   # 4K Big Buck Bunny
#   bash tools/test-download "<URL>"                           # any video, 4K
#   bash tools/test-download "<URL>" <preset>                  # specific preset
#   bash tools/test-download "<URL>" <preset> <save-location>  # e.g. "movies"
#
# Preset:        best 4k 2k 1080p 720p 480p audio
# Save location: downloads movies videos desktop documents

set +e

INSTALL_DIR="/Library/Application Support/PixelCatch"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BRIDGE="$REPO_ROOT/tools/_helper-bridge.py"
URL="${1:-https://www.youtube.com/watch?v=aqz-KE-bpKQ}"
PRESET="${2:-4k}"
SAVE_LOC="${3:-}"
DOWNLOADS="$HOME/Downloads"

if [ ! -f "$BRIDGE" ]; then
    echo "Helper bridge not found at $BRIDGE" >&2
    exit 1
fi

# Mark file so we can tell which files in ~/Downloads are from THIS run.
MARK_FILE=$(mktemp -t pc-test-mark)
trap 'rm -f "$MARK_FILE"' EXIT

echo "================================================================"
echo "PixelCatch test download (via helper)"
echo "  URL:       $URL"
echo "  Preset:    $PRESET"
echo "  Save to:   ${SAVE_LOC:-(default — Downloads)}"
echo "  Helper:    $INSTALL_DIR/downloader.py"
echo "================================================================"
echo

python3 "$BRIDGE" "$URL" "$PRESET" "$SAVE_LOC"
HELPER_EXIT=$?

echo
echo "================================================================"
echo "Helper exit code: $HELPER_EXIT"
echo
echo "=== 5 most recent files in ~/Downloads ==="
ls -lht "$DOWNLOADS" 2>/dev/null | head -6

echo
echo "=== Files modified during this run (newer than mark) ==="
find "$DOWNLOADS" -maxdepth 1 -type f -newer "$MARK_FILE" 2>/dev/null \
    | while IFS= read -r f; do ls -lh "$f"; done

echo
echo "=== ffprobe says (so you can verify actual resolution): ==="
LAST_FILE=$(find "$DOWNLOADS" -maxdepth 1 -type f -newer "$MARK_FILE" 2>/dev/null \
    \( -name "*.mp4" -o -name "*.mkv" -o -name "*.webm" -o -name "*.m4a" \) \
    | head -1)
if [ -z "$LAST_FILE" ]; then
    LAST_FILE=$(ls -t "$DOWNLOADS"/*.{mp4,mkv,webm,m4a} 2>/dev/null | head -1)
fi
if [ -n "$LAST_FILE" ] && [ -x "$INSTALL_DIR/ffprobe" ]; then
    "$INSTALL_DIR/ffprobe" -v error -select_streams v:0 \
        -show_entries stream=width,height,codec_name,bit_rate \
        -of default=noprint_wrappers=1 "$LAST_FILE" 2>&1
    # Show audio stream info too — confirms which language got picked.
    echo
    "$INSTALL_DIR/ffprobe" -v error -select_streams a:0 \
        -show_entries stream=codec_name,sample_rate,channels:stream_tags=language \
        -of default=noprint_wrappers=1 "$LAST_FILE" 2>&1
    echo
    echo "File: $LAST_FILE"
    echo "Size: $(du -h "$LAST_FILE" | cut -f1)"
else
    echo "No video file found in ~/Downloads from this run."
    echo "(If the helper exited non-zero above, see the error for why.)"
fi
echo "================================================================"
