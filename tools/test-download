#!/usr/bin/env bash
#
# Bypass the popup and run a real download with the exact same yt-dlp
# invocation the helper uses. Prints everything along the way so we can see
# what file lands, what resolution it actually is, and any merge errors.
#
# Usage:
#   bash tools/test-download                                   # Big Buck Bunny 4K
#   bash tools/test-download "<URL>"                           # any video
#   bash tools/test-download "<URL>" 1080p                     # specific preset
#
# Presets: best 4k 2k 1080p 720p 480p audio

set +e

INSTALL_DIR="/Library/Application Support/PixelCatch"
URL="${1:-https://www.youtube.com/watch?v=aqz-KE-bpKQ}"
PRESET="${2:-4k}"

# Format presets — kept in sync with FORMAT_PRESETS in native/downloader.py.
# 1080p / 720p / 480p strongly prefer AVC + AAC so output is always a clean mp4.
# 2K / 4K accept VP9 / AV1 (YouTube doesn't serve AVC above 1080p) and use the
# runner's --merge-output-format mp4/mkv fallback. `lang` appears in every
# sort key so multi-track videos pick the English audio.
case "$PRESET" in
    best)
        FMT="bv*+ba/best"
        SORT="res,tbr,fps,vcodec:av01,acodec:opus,lang,channels" ;;
    4k)
        FMT="bv*[height<=2160]+ba/best[height<=2160]"
        SORT="res:2160,tbr,fps,vcodec:av01,acodec:opus,lang" ;;
    2k)
        FMT="bv*[height<=1440]+ba/best[height<=1440]"
        SORT="res:1440,tbr,fps,vcodec:av01,acodec:opus,lang" ;;
    1080p)
        FMT="bv*[height<=1080][vcodec~='^(avc|h264)']+ba[ext=m4a]/best[height<=1080][ext=mp4]/best[height<=1080]"
        SORT="res:1080,tbr,fps,vcodec:avc1,acodec:m4a,lang" ;;
    720p)
        FMT="bv*[height<=720][vcodec~='^(avc|h264)']+ba[ext=m4a]/best[height<=720][ext=mp4]/best[height<=720]"
        SORT="res:720,tbr,fps,vcodec:avc1,acodec:m4a,lang" ;;
    480p)
        FMT="bv*[height<=480][vcodec~='^(avc|h264)']+ba[ext=m4a]/best[height<=480][ext=mp4]/best[height<=480]"
        SORT="res:480,tbr,fps,vcodec:avc1,acodec:m4a,lang" ;;
    audio)
        FMT="ba[ext=m4a]/ba/best"
        SORT="abr,acodec:m4a:opus,lang" ;;
    *)
        echo "Unknown preset: $PRESET" >&2; exit 1 ;;
esac

DOWNLOADS="$HOME/Downloads"
# BSD find on macOS doesn't support GNU's `-newermt "@<epoch>"` syntax.
# Instead, drop a reference file before the download and use `-newer` against
# it afterward — works on both BSD and GNU find.
MARK_FILE=$(mktemp -t pc-test-mark)
trap 'rm -f "$MARK_FILE"' EXIT
echo "================================================================"
echo "PixelCatch test download"
echo "  URL:       $URL"
echo "  Preset:    $PRESET"
echo "  -f:        $FMT"
echo "  -S:        $SORT"
echo "  Save to:   $DOWNLOADS"
echo "================================================================"
echo

"$INSTALL_DIR/yt-dlp" \
    --cookies-from-browser chrome \
    --extractor-args "youtube:player_client=tv,web,web_safari,mweb;lang=en" \
    --no-playlist \
    -f "$FMT" \
    -S "$SORT" \
    --merge-output-format mp4/mkv \
    --newline \
    --print "[selected] %(format_id)s %(width)sx%(height)s @ %(tbr)skbps %(vcodec)s+%(acodec)s lang=%(language)s" \
    -o "$DOWNLOADS/%(title)s.%(ext)s" \
    "$URL"
EXIT_CODE=$?

echo
echo "================================================================"
echo "yt-dlp exit code: $EXIT_CODE"
echo
echo "=== Files in ~/Downloads modified during this run ==="
find "$DOWNLOADS" -maxdepth 1 -type f -newer "$MARK_FILE" -print0 \
    | xargs -0 -I{} ls -lh "{}" 2>/dev/null

echo
echo "=== ffprobe says (so you can verify actual resolution): ==="
LAST_FILE=$(find "$DOWNLOADS" -maxdepth 1 -type f -newer "$MARK_FILE" \
    \( -name "*.mp4" -o -name "*.mkv" -o -name "*.webm" -o -name "*.m4a" \) \
    | head -1)
if [ -n "$LAST_FILE" ] && [ -x "$INSTALL_DIR/ffprobe" ]; then
    "$INSTALL_DIR/ffprobe" -v error -select_streams v:0 \
        -show_entries stream=width,height,codec_name,bit_rate \
        -of default=noprint_wrappers=1 "$LAST_FILE" 2>&1
    echo
    echo "File:  $LAST_FILE"
    echo "Size:  $(du -h "$LAST_FILE" | cut -f1)"
else
    echo "No video file found in ~/Downloads from this run."
    echo "(If yt-dlp exited non-zero above, see the error message for why.)"
fi
echo "================================================================"
