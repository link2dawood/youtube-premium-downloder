{
  "manifest_version": 3,
  "name": "Pixel Catch",
  "version": "0.6.0",
  "description": "Pixel Catch lets you download YouTube videos in multiple available resolutions through a clean and seamless Chrome extension experience.",
  "action": {
    "default_title": "Pixel Catch"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "identity",
    "nativeMessaging",
    "storage",
    "windows"
  ],
  "host_permissions": [
    "https://accounts.google.com/*",
    "https://gmail.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "865980709872-7as1atkavuo2plo6l8kubqusnm1rc3et.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/gmail.compose"
    ]
  }
}
